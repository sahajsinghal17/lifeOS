{
  "name": "lifeos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@lifeos/web",
    "build:web": "npm run build --workspace=@lifeos/web",
    "lint:web": "npm run lint --workspace=@lifeos/web",
    "dev:api": "npm run dev --workspace=@lifeos/api",
    "build:api": "npm run build --workspace=@lifeos/api",
    "start:api": "npm run start --workspace=@lifeos/api",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:api": "npm run lint --workspace=@lifeos/api"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
